HTTP_ADDR=127.0.0.1:8090
GRPC_ADDR=127.0.0.1:50051
# PostgreSQL system of record (all metrics, endpoints, settings, SoftEther history)
DATABASE_URL=postgres://nevarix:nevarix@127.0.0.1:55432/nevarix?sslmode=disable
# Shared with nevarix-agent NEVARIX_AGENT_TOKEN (required for agent REST and gRPC ingest)
AGENT_INGEST_TOKEN=change-me
CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
SOFTETHER_CONTAINER=nevarix-softether
SOFTETHER_PASSWORD=nevarix
SOFTETHER_HUB=DEFAULT
SOFTETHER_ENABLED=true
METRICS_HISTORY_POINTS=60
SOFTETHER_POLL_SECONDS=30
