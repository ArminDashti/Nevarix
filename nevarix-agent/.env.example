NEVARIX_CORE_URL=http://127.0.0.1:8090
# Must match AGENT_INGEST_TOKEN on nevarix-core
NEVARIX_AGENT_TOKEN=change-me
# SQLite outbox: snapshots stay here until nevarix-core acknowledges them
NEVARIX_OUTBOX_PATH=data/agent-outbox.db
# Optional; defaults to hostname
# NEVARIX_AGENT_ID=t3-host-1
# NEVARIX_HOSTNAME=irancell-t3
COLLECT_INTERVAL_SECONDS=5
# Health endpoint probed by nevarix-core scan (default :9000)
# NEVARIX_LISTEN_ADDR=:9000
