HTTP_ADDR=127.0.0.1:8090
# Managment local data (SQLite): holds the SoftEther outbox until Hub acknowledges it
SQLITE_PATH=data/managment.db
# Hub is the system of record (PostgreSQL)
HUB_URL=http://127.0.0.1:8091
# Must match HUB_INGEST_TOKEN on nevarix-hub
HUB_INGEST_TOKEN=change-me
CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
SOFTETHER_CONTAINER=nevarix-softether
SOFTETHER_PASSWORD=nevarix
SOFTETHER_HUB=DEFAULT
SOFTETHER_ENABLED=true
METRICS_HISTORY_POINTS=60
SOFTETHER_POLL_SECONDS=30
